# Never commit a real keypair or API credential.
RPC_URL=https://api.mainnet-beta.solana.com
KEYPAIR_PATH=/absolute/path/to/your/dev-or-mainnet-keypair.json

# Set after `anchor keys list` / deployment.
RFQ_PROGRAM_ID=Fg6PaFpoGXkYsidMpWTK6W2BeZ7FEfcYkg476zPFsLnS

# Direct, fixed maker-pair accounts created by this program.
MAKER_PAIR_AB=
MAKER_PAIR_BA=
RFQ_ONE_ID=1
RFQ_TWO_ID=2

# Token accounts belonging to the same executor keypair.
# The input ATA must be the account Jupiter Lend's flash-borrow flow funds.
TAKER_A_TOKEN_ACCOUNT=
TAKER_B_TOKEN_ACCOUNT=

# Flash-loan asset A and amount in base units.
FLASH_ASSET_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
FLASH_AMOUNT=1000000
MIN_PROFIT_A=1

# Safety breaker. The mainnet execution script refuses to submit unless true.
ALLOW_MAINNET_SUBMISSION=false
